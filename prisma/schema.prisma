// Modelo de dados — ver docs/04-banco-de-dados.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Papel {
  cliente
  vendedor
  gestor
}

enum Genero {
  feminino
  masculino
  unissex
}

enum Estacao {
  inverno
  verao
}

enum TipoPedido {
  compra
  condicional
}

enum StatusPedido {
  pendente
  confirmado
  cancelado
}

enum OrigemPedido {
  loja
  vendedor
  /// Venda feita na loja física, com as peças escolhidas no painel (Q-04).
  balcao
}

enum SituacaoItem {
  pendente
  vendido
  devolvido
}

enum MotivoEstoque {
  entrada
  ajuste
  venda
  /// Venda desfeita: o pedido confirmado foi cancelado e as peças voltaram ao estoque.
  estorno
}

// ---------- Better Auth ----------

model User {
  id                      String             @id @default(cuid())
  name                    String
  email                   String             @unique
  emailVerified           Boolean            @default(false)
  image                   String?            @db.Text
  papel                   Papel              @default(cliente)
  telefone                String?            @db.VarChar(20)
  ativo                   Boolean            @default(true)
  /// LGPD: quando a pessoa aceitou a política de privacidade (null = ainda não aceitou).
  aceitouPrivacidadeEm    DateTime?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  sessions                Session[]
  accounts                Account[]
  cliente                 Cliente?           @relation("ContaDoCliente")
  clientes                Cliente[]          @relation("VendedorDoCliente")
  metas                   Meta[]
  pedidos                 Pedido[]           @relation("PedidosDoVendedor")
  sugestoes               Sugestao[]         @relation("SugestoesDoVendedor")
  notificacoes            Notificacao[]
  /// D-28: tipos de notificação desligados no painel e por e-mail ({ painel: [...], email: [...] }); vazio = padrão.
  preferenciasNotificacao Json?
  vendas                  Venda[]            @relation("VendasDoVendedor")
  movimentos              MovimentoEstoque[] @relation("MovimentosDoUsuario")
  historicoPedidos        PedidoHistorico[]  @relation("HistoricoDoUsuario")
  cuponsCriados           Cupom[]            @relation("CuponsCriados")
  /// Acompanhamento da equipe (D-26): último login e último sinal do painel ou do caixa aberto.
  ultimoLoginEm           DateTime?
  ultimoAcessoEm          DateTime?
  sessoesEquipe           SessaoEquipe[]
  atividadesEquipe        AtividadeEquipe[]

  @@map("user")
}

/// Acompanhamento da equipe (D-26): o que cada pessoa da equipe fez no painel e no caixa.
enum AcaoEquipe {
  login
  cliente_cadastrado
  cliente_editado
  pedido_criado
  oferta_enviada
  pedido_editado
  pedido_confirmado
  pedido_cancelado
  venda_desfeita
  venda_balcao
  venda_caixa
  venda_manual
  venda_excluida
  cupom_pedido
  whatsapp
  cupom_enviado
  convite_enviado
}

/// Uso do painel e do caixa (D-26): uma sessão vai do primeiro ao último sinal, com até 5 min de intervalo entre eles.
model SessaoEquipe {
  id        Int      @id @default(autoincrement())
  usuarioId String
  usuario   User     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  inicioEm  DateTime
  fimEm     DateTime
  /// Tempo com a tela visível, em segundos (aba escondida ou computador parado não conta).
  segundos  Int      @default(0)
  /// celular, tablet ou computador.
  aparelho  String?  @db.VarChar(12)

  @@index([usuarioId, fimEm])
  @@index([inicioEm])
  @@map("sessao_equipe")
}

/// Histórico de ações da equipe (D-26). Sem chave estrangeira para cliente e pedido: o histórico não some com eles.
model AtividadeEquipe {
  id        BigInt     @id @default(autoincrement())
  usuarioId String
  usuario   User       @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tipo      AcaoEquipe
  clienteId String?
  pedidoId  String?
  /// Valor da venda ou do pedido, quando há.
  valor     Decimal?   @db.Decimal(10, 2)
  /// Frase curta para a lista ("Fulana · PED-000123 · 3 peças").
  descricao String?    @db.VarChar(200)
  aparelho  String?    @db.VarChar(12)
  criadoEm  DateTime   @default(now())

  @@index([usuarioId, criadoEm])
  @@index([tipo, criadoEm])
  @@index([criadoEm])
  @@map("atividade_equipe")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?  @db.Text
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?   @db.Text
  password              String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String   @db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ---------- Clientes e metas ----------

model Cliente {
  id             String         @id @default(cuid())
  userId         String?        @unique
  user           User?          @relation("ContaDoCliente", fields: [userId], references: [id], onDelete: SetNull)
  vendedorId     String
  vendedor       User           @relation("VendedorDoCliente", fields: [vendedorId], references: [id])
  nome           String
  telefone       String         @db.VarChar(20)
  /// Opcional, com a máscara 000.000.000-00 (validado pelos dígitos verificadores).
  cpf            String?        @db.Char(14)
  email          String?
  endereco       String?
  cidade         String?
  cep            String?        @db.Char(9)
  preferencias   String?
  criadoEm       DateTime       @default(now())
  /// Histórico de navegação (docs/21): último login e última página aberta na loja.
  ultimoLoginEm  DateTime?
  ultimoAcessoEm DateTime?
  pedidos        Pedido[]
  vendas         Venda[]
  cupons         CupomCliente[]
  atividades     Atividade[]
  favoritos      Favorito[]
  sacola         SacolaCliente?
  sugestoes      Sugestao[]

  @@index([vendedorId])
  @@index([telefone])
  @@index([cpf])
  @@index([ultimoAcessoEm])
  @@map("cliente")
}

model Meta {
  id         String  @id @default(cuid())
  vendedorId String
  vendedor   User    @relation(fields: [vendedorId], references: [id], onDelete: Cascade)
  mes        String  @db.Char(7) // "2026-09"
  valor      Decimal @db.Decimal(10, 2)

  @@unique([vendedorId, mes])
  @@map("meta")
}

// ---------- Catálogo ----------

model Marca {
  id       Int          @id @default(autoincrement())
  nome     String
  slug     String       @unique
  produtos Produto[]
  cupons   CupomMarca[]

  @@map("marca")
}

model Categoria {
  id       Int              @id @default(autoincrement())
  nome     String
  slug     String           @unique
  produtos Produto[]
  cupons   CupomCategoria[]

  @@map("categoria")
}

model Produto {
  id           Int             @id @default(autoincrement())
  referencia   String          @unique @db.VarChar(20)
  nome         String          @db.VarChar(160)
  marcaId      Int
  marca        Marca           @relation(fields: [marcaId], references: [id])
  categoriaId  Int
  categoria    Categoria       @relation(fields: [categoriaId], references: [id])
  subcategoria String?
  genero       Genero
  estacao      Estacao?
  cor          String?
  composicao   String?         @db.Text
  descricao    String?         @db.Text
  destaques    Json?
  preco        Decimal         @db.Decimal(10, 2)
  precoCheio   Decimal         @db.Decimal(10, 2)
  imperdivel   Boolean         @default(false)
  ativo        Boolean         @default(true)
  linkOrigem   String?         @db.Text
  criadoEm     DateTime        @default(now())
  atualizadoEm DateTime        @updatedAt
  imagens      ProdutoImagem[]
  videos       ProdutoVideo[]
  variantes    Variante[]
  custo        Custo?
  cupons       CupomProduto[]
  favoritos    Favorito[]

  @@index([ativo, genero, categoriaId])
  @@map("produto")
}

model ProdutoImagem {
  id        Int     @id @default(autoincrement())
  produtoId Int
  produto   Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  url       String  @db.Text
  ordem     Int     @default(0)

  @@index([produtoId, ordem])
  @@map("produto_imagem")
}

/// Vídeo do produto (D-29): arquivo em /arquivos/produtos/<REF>/ e capa (foto WebP tirada de um quadro do vídeo).
model ProdutoVideo {
  id        Int     @id @default(autoincrement())
  produtoId Int
  produto   Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  url       String  @db.Text
  capa      String? @db.Text
  ordem     Int     @default(0)

  @@index([produtoId, ordem])
  @@map("produto_video")
}

model Variante {
  id            Int                @id @default(autoincrement())
  produtoId     Int
  produto       Produto            @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  tamanho       String             @db.VarChar(5)
  ordem         Int                @default(0)
  estoque       Int                @default(0)
  reservado     Int                @default(0)
  codigoInterno String?            @unique @db.VarChar(20)
  ean           String?            @db.VarChar(14)
  movimentos    MovimentoEstoque[]
  itens         PedidoItem[]

  @@unique([produtoId, tamanho])
  @@map("variante")
}

model Custo {
  produtoId    Int      @id
  produto      Produto  @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  valor        Decimal  @db.Decimal(10, 2)
  atualizadoEm DateTime @updatedAt

  @@map("custo")
}

model MovimentoEstoque {
  id         Int           @id @default(autoincrement())
  varianteId Int
  variante   Variante      @relation(fields: [varianteId], references: [id], onDelete: Cascade)
  delta      Int
  motivo     MotivoEstoque
  observacao String?
  pedidoId   String?
  pedido     Pedido?       @relation(fields: [pedidoId], references: [id], onDelete: SetNull)
  usuarioId  String?
  usuario    User?         @relation("MovimentosDoUsuario", fields: [usuarioId], references: [id], onDelete: SetNull)
  criadoEm   DateTime      @default(now())

  @@index([varianteId, criadoEm])
  @@index([pedidoId])
  @@index([usuarioId])
  @@map("movimento_estoque")
}

// ---------- Pedidos e vendas ----------

model Pedido {
  id                 String             @id @default(cuid())
  codigo             String             @unique @db.VarChar(15)
  tipo               TipoPedido
  status             StatusPedido       @default(pendente)
  origem             OrigemPedido
  clienteId          String
  cliente            Cliente            @relation(fields: [clienteId], references: [id])
  vendedorId         String
  vendedor           User               @relation("PedidosDoVendedor", fields: [vendedorId], references: [id])
  nomeCliente        String
  telefoneCliente    String             @db.VarChar(20)
  cep                String?            @db.Char(9)
  total              Decimal            @db.Decimal(10, 2)
  /// Frete do pedido de compra, gravado no envio (Q-01). null = a combinar (loja sem regra de frete, condicional, seleção do vendedor).
  frete              Decimal?           @db.Decimal(10, 2)
  criadoEm           DateTime           @default(now())
  confirmadoEm       DateTime?
  canceladoEm        DateTime?
  /// Quem ou o que cancelou: equipe, cliente ou expirado (Q-05).
  motivoCancelamento String?            @db.VarChar(20)
  /// Cupom aplicado (docs/20-cupons.md). O código é cópia: o pedido continua legível se o cupom for apagado.
  cupomId            Int?
  cupom              Cupom?             @relation(fields: [cupomId], references: [id], onDelete: SetNull)
  codigoCupom        String?            @db.VarChar(30)
  /// Desconto do cupom nas peças (soma de `descontoCupom` das linhas). `total` já vem descontado.
  descontoCupom      Decimal            @default(0) @db.Decimal(10, 2)
  /// Frete zerado por cupom de frete grátis.
  freteCupom         Boolean            @default(false)
  itens              PedidoItem[]
  venda              Venda?
  movimentos         MovimentoEstoque[]
  historico          PedidoHistorico[]
  /// Venda no caixa da loja (D-23): como foi paga (pode ser dividida).
  pagamentos         Pagamento[]

  @@index([vendedorId, status, criadoEm])
  @@index([clienteId])
  @@index([cupomId, status])
  @@map("pedido")
}

model PedidoItem {
  id            Int          @id @default(autoincrement())
  pedidoId      String
  pedido        Pedido       @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  varianteId    Int
  variante      Variante     @relation(fields: [varianteId], references: [id])
  produtoId     Int
  referencia    String       @db.VarChar(20)
  nome          String
  marca         String
  cor           String?
  categoria     String
  imagem        String?      @db.Text
  tamanho       String       @db.VarChar(5)
  codigoInterno String?
  quantidade    Int
  precoUnitario Decimal      @db.Decimal(10, 2)
  /// Preço do catálogo quando a peça entrou no pedido; abaixo dele, `precoUnitario` tem desconto do vendedor.
  precoTabela   Decimal?     @db.Decimal(10, 2)
  /// Parte do desconto do cupom nesta linha, em R$, para a quantidade toda.
  descontoCupom Decimal      @default(0) @db.Decimal(10, 2)
  custoUnitario Decimal?     @db.Decimal(10, 2)
  situacao      SituacaoItem @default(pendente)

  @@index([pedidoId])
  @@map("pedido_item")
}

enum TipoCupom {
  percentual
  valor
  freteGratis
}

enum QuemAplica {
  cliente
  equipe
  ambos
}

/// manual: criado pelo gestor; primeiraCompra: campanha de boas-vindas; proximaCompra: modelo da campanha ou cupom pessoal gerado por ela.
enum OrigemCupom {
  manual
  primeiraCompra
  proximaCompra
}

/// Cupom de desconto (docs/20-cupons.md). Só o gestor cria; o uso fica no pedido (pedido não cancelado = um uso).
model Cupom {
  id                    Int              @id @default(autoincrement())
  /// Letras, números e hífen, em maiúsculas.
  codigo                String           @unique @db.VarChar(30)
  descricao             String?          @db.VarChar(200)
  tipo                  TipoCupom
  /// % (percentual) ou R$ (valor); null no frete grátis.
  valor                 Decimal?         @db.Decimal(10, 2)
  /// Só no percentual: o desconto não passa disto.
  tetoDesconto          Decimal?         @db.Decimal(10, 2)
  /// Soma de todas as peças do pedido (com o desconto do vendedor, sem frete), antes do cupom.
  minimoCompra          Decimal?         @db.Decimal(10, 2)
  inicioEm              DateTime         @default(now())
  fimEm                 DateTime?
  limiteTotal           Int?
  limitePorCliente      Int?             @default(1)
  somentePrimeiraCompra Boolean          @default(false)
  valePromocao          Boolean          @default(false)
  quemAplica            QuemAplica       @default(ambos)
  ativo                 Boolean          @default(true)
  /// Campanhas (fase 4): de onde veio o cupom.
  origem                OrigemCupom      @default(manual)
  /// Modelo da campanha de próxima compra: guarda as opções copiadas para cada cupom pessoal; nunca é aplicado.
  modelo                Boolean          @default(false)
  /// Cupom pessoal de próxima compra: o modelo que o gerou e a venda que o originou.
  modeloId              Int?
  modeloCupom           Cupom?           @relation("CuponsDoModelo", fields: [modeloId], references: [id], onDelete: SetNull)
  gerados               Cupom[]          @relation("CuponsDoModelo")
  pedidoOrigemId        String?
  /// Primeira compra: vale até N dias depois do cadastro da cliente (null = até a primeira compra).
  diasAposCadastro      Int?
  criadoPorId           String?
  criadoPor             User?            @relation("CuponsCriados", fields: [criadoPorId], references: [id], onDelete: SetNull)
  criadoEm              DateTime         @default(now())
  atualizadoEm          DateTime         @updatedAt
  categorias            CupomCategoria[]
  marcas                CupomMarca[]
  produtos              CupomProduto[]
  clientes              CupomCliente[]
  pedidos               Pedido[]

  @@index([ativo, inicioEm])
  @@index([origem, modelo])
  @@index([modeloId])
  @@map("cupom")
}

model CupomCategoria {
  cupomId     Int
  cupom       Cupom     @relation(fields: [cupomId], references: [id], onDelete: Cascade)
  categoriaId Int
  categoria   Categoria @relation(fields: [categoriaId], references: [id], onDelete: Cascade)

  @@id([cupomId, categoriaId])
  @@index([categoriaId])
  @@map("cupom_categoria")
}

model CupomMarca {
  cupomId Int
  cupom   Cupom @relation(fields: [cupomId], references: [id], onDelete: Cascade)
  marcaId Int
  marca   Marca @relation(fields: [marcaId], references: [id], onDelete: Cascade)

  @@id([cupomId, marcaId])
  @@index([marcaId])
  @@map("cupom_marca")
}

model CupomProduto {
  cupomId   Int
  cupom     Cupom   @relation(fields: [cupomId], references: [id], onDelete: Cascade)
  produtoId Int
  produto   Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  @@id([cupomId, produtoId])
  @@index([produtoId])
  @@map("cupom_produto")
}

/// Cupom só para clientes específicos (sem linhas = todos).
model CupomCliente {
  cupomId   Int
  cupom     Cupom   @relation(fields: [cupomId], references: [id], onDelete: Cascade)
  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@id([cupomId, clienteId])
  @@index([clienteId])
  @@map("cupom_cliente")
}

enum AcaoPedido {
  criado
  editado
  confirmado
  cancelado
}

/// Rastreio do pedido: o que a cliente pediu (criado), cada edição da equipe e o fechamento.
model PedidoHistorico {
  id          Int        @id @default(autoincrement())
  pedidoId    String
  pedido      Pedido     @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  acao        AcaoPedido
  /// cliente, equipe ou sistema (expiração). O nome só é guardado para a equipe (LGPD: a cliente pode ser anonimizada).
  autor       String     @db.VarChar(10)
  usuarioId   String?
  usuario     User?      @relation("HistoricoDoUsuario", fields: [usuarioId], references: [id], onDelete: SetNull)
  nomeUsuario String?
  /// Frases do que mudou ("Trocou ... por ...", "Preço de ... para ...").
  mudancas    Json
  /// Peças como ficaram depois da ação: [{ referencia, nome, cor, tamanho, quantidade, preco, precoTabela }].
  itens       Json
  total       Decimal    @db.Decimal(10, 2)
  frete       Decimal?   @db.Decimal(10, 2)
  observacao  String?    @db.Text
  criadoEm    DateTime   @default(now())

  @@index([pedidoId, criadoEm])
  @@index([usuarioId])
  @@map("pedido_historico")
}

model Venda {
  id         String   @id @default(cuid())
  pedidoId   String?  @unique
  pedido     Pedido?  @relation(fields: [pedidoId], references: [id])
  vendedorId String
  vendedor   User     @relation("VendasDoVendedor", fields: [vendedorId], references: [id])
  clienteId  String?
  cliente    Cliente? @relation(fields: [clienteId], references: [id])
  valor      Decimal  @db.Decimal(10, 2)
  custo      Decimal? @db.Decimal(10, 2)
  data       DateTime
  observacao String?
  criadoEm   DateTime @default(now())

  @@index([vendedorId, data])
  @@map("venda")
}

// ---------- Histórico do cliente (docs/21-historico-do-cliente.md) ----------

/// login: entrou com a senha; acesso: começou uma visita (30 min sem atividade); pagina, produto, busca, filtro: abriu uma
/// página da loja; tamanho: escolheu um tamanho; sacola: pôs ou tirou peça; cupom: tentou um código; whatsapp: clicou para falar.
enum TipoAtividade {
  login
  acesso
  pagina
  produto
  busca
  filtro
  tamanho
  sacola
  cupom
  whatsapp
}

/// Navegação da cliente na loja, para o vendedor e o gestor entenderem o interesse dela. Sem IP (D-18).
/// Sai junto com a conta (LGPD) e depois de 12 meses.
model Atividade {
  id         BigInt        @id @default(autoincrement())
  clienteId  String
  cliente    Cliente       @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  tipo       TipoAtividade
  /// Página com os filtros, ex.: /catalogo?categoria=blusas.
  caminho    String?       @db.VarChar(300)
  /// Sem chave estrangeira: produto excluído não apaga o histórico.
  produtoId  Int?
  varianteId Int?
  /// Termo da busca, código do cupom ou tamanho escolhido.
  termo      String?       @db.VarChar(100)
  /// Filtros do catálogo, quantidade de resultados, peças a mais ou a menos na sacola, resultado do cupom.
  dados      Json?
  /// Tempo com a página aberta e visível, em segundos.
  duracaoSeg Int?
  /// celular, tablet ou computador.
  aparelho   String?       @db.VarChar(12)
  /// Identifica a página aberta no navegador, para somar o tempo depois.
  ref        String?       @db.VarChar(16)
  criadoEm   DateTime      @default(now())

  @@index([clienteId, criadoEm])
  @@index([clienteId, ref])
  @@index([clienteId, tipo, produtoId])
  @@index([produtoId, criadoEm])
  @@index([tipo, criadoEm])
  @@map("atividade")
}

/// Cópia da sacola do navegador: o vendedor vê o que a cliente separou e recebe aviso se ela não enviar.
model SacolaCliente {
  clienteId    String    @id
  cliente      Cliente   @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  /// [{ varianteId, quantidade }]
  itens        Json
  atualizadoEm DateTime  @updatedAt
  /// Quando o vendedor foi avisado de que a sacola ficou parada (null = ainda não).
  avisadoEm    DateTime?

  @@index([atualizadoEm])
  @@map("sacola_cliente")
}

/// Peças que a cliente marcou com o coração na loja (D-22). Vale em qualquer aparelho; o vendedor vê na ficha.
model Favorito {
  clienteId String
  cliente   Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  produtoId Int
  produto   Produto  @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  criadoEm  DateTime @default(now())

  @@id([clienteId, produtoId])
  @@index([produtoId])
  @@map("favorito")
}

/// Forma de pagamento da venda no caixa (D-23).
enum FormaPagamento {
  pix
  debito
  credito
  dinheiro
}

/// Pagamento de uma venda no caixa da loja (D-23). Uma venda pode ter mais de um (ex.: parte no Pix, parte no cartão).
model Pagamento {
  id       Int            @id @default(autoincrement())
  pedidoId String
  pedido   Pedido         @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  forma    FormaPagamento
  valor    Decimal        @db.Decimal(10, 2)
  /// Crédito: em quantas vezes.
  parcelas Int?
  /// Dinheiro: quanto a cliente entregou (troco = recebido − valor).
  recebido Decimal?       @db.Decimal(10, 2)
  criadoEm DateTime       @default(now())

  @@index([pedidoId])
  @@index([forma, criadoEm])
  @@map("pagamento")
}

// ---------- Sistema ----------

model Configuracao {
  chave String @id
  valor Json

  @@map("configuracao")
}

model Contador {
  nome  String @id
  valor Int    @default(0)

  @@map("contador")
}

/// Sugestões para você (D-27, docs/23): proposta do vendedor que a cliente responde pelo link. Não reserva estoque.
enum StatusSugestao {
  enviada
  vista
  respondida
  convertida
  cancelada
}

enum EscolhaSugestao {
  pendente
  quero
  talvez
  nao
}

model Sugestao {
  id           String         @id @default(cuid())
  /// SUG-000001; o link é /s/<codigo>.<assinatura> (link-pedido.ts).
  codigo       String         @unique @db.VarChar(15)
  vendedorId   String
  vendedor     User           @relation("SugestoesDoVendedor", fields: [vendedorId], references: [id])
  clienteId    String
  cliente      Cliente        @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  titulo       String         @db.VarChar(80)
  mensagem     String?        @db.Text
  status       StatusSugestao @default(enviada)
  /// Depois disso a sugestão vence: o link só leva a falar com o vendedor, e os preços especiais deixam de valer.
  validaAte    DateTime
  criadaEm     DateTime       @default(now())
  vistaEm      DateTime?
  vezesVista   Int            @default(0)
  respondidaEm DateTime?
  /// Pedido ou condicional gerado quando a cliente devolve as escolhas.
  pedidoId     String?        @unique
  /// Quando o link foi mandado; null = criado com "Só criar", ainda para enviar.
  enviadaEm    DateTime?
  /// Cupom que a sugestão aplica ao virar pedido (fase 2).
  cupomCodigo  String?        @db.VarChar(30)
  /// Lembrete pelo WhatsApp ("viu as peças?"): o último e quantos já foram.
  lembradoEm   DateTime?
  lembretes    Int            @default(0)
  itens        SugestaoItem[]

  @@index([vendedorId, criadaEm])
  @@index([clienteId, criadaEm])
  @@map("sugestao")
}

model SugestaoItem {
  id                    Int             @id @default(autoincrement())
  sugestaoId            String
  sugestao              Sugestao        @relation(fields: [sugestaoId], references: [id], onDelete: Cascade)
  /// A cor da peça (cada cor é um produto); a cliente pode trocar por outra cor do mesmo modelo.
  produtoId             Int
  /// Tamanho sugerido pelo vendedor (null = a cliente escolhe).
  varianteId            Int?
  /// Preço especial por unidade, até a validade; null = preço do catálogo.
  precoOferta           Decimal?        @db.Decimal(10, 2)
  nota                  String?         @db.VarChar(200)
  ordem                 Int             @default(0)
  escolha               EscolhaSugestao @default(pendente)
  /// Tamanho e cor que a cliente escolheu (variante de qualquer cor do modelo).
  varianteEscolhidaId   Int?
  quantidade            Int             @default(1)
  adicionadoPelaCliente Boolean         @default(false)

  @@index([sugestaoId])
  @@map("sugestao_item")
}

/// Notificações da equipe (D-28): o sino da barra superior, a página Notificações e, conforme a preferência, o e-mail.
enum TipoNotificacao {
  pedido_novo
  pedido_cancelado
  carrinho_visto
  carrinho_respondido
  sacola_parada
  prazo_vencendo
  peca_esgotada
  meta_batida
  cliente_nova
  carrinho_vencendo
}

model Notificacao {
  id        BigInt          @id @default(autoincrement())
  usuarioId String
  usuario   User            @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tipo      TipoNotificacao
  titulo    String          @db.VarChar(140)
  texto     String?         @db.VarChar(300)
  /// Caminho do painel para abrir ("/painel/pedidos/…").
  link      String?         @db.VarChar(300)
  /// Evita a mesma notificação duas vezes para a mesma pessoa (ex.: "prazo:PED-000123").
  chave     String?         @db.VarChar(100)
  lidaEm    DateTime?
  criadaEm  DateTime        @default(now())

  @@unique([usuarioId, chave])
  @@index([usuarioId, lidaEm, criadaEm])
  @@index([criadaEm])
  @@map("notificacao")
}
