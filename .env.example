# Banco (docker-compose expõe o MySQL na porta 3307)
DATABASE_URL="mysql://dcerutti:dcerutti@localhost:3307/dcerutti"

# Autenticação (Better Auth) — gere com: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Imagens (Cloudflare R2) — opcional; sem isso o painel aceita apenas URLs de imagem
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="dcerutti-produtos"
NEXT_PUBLIC_IMAGENS_URL=""

# Site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Senha dos usuários criados por `npm run db:seed` (somente desenvolvimento)
SEED_SENHA="dcerutti123"
