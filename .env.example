# Banco (docker-compose expõe o MySQL na porta 3307)
DATABASE_URL="mysql://dcerutti:dcerutti@localhost:3307/dcerutti"

# Autenticação (Better Auth) — gere com: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Opcional: assina os links públicos de pedido (/p/PED-000123.…, D-20). Sem ele, usa o BETTER_AUTH_SECRET.
# Trocar invalida os links já enviados.
LINK_PEDIDO_SEGREDO=""

# Fotos enviadas ficam no servidor (D-13). Padrão: <projeto>/armazenamento
ARMAZENAMENTO_DIR=""

# E-mail (recuperação de senha). Sem SMTP_URL, o e-mail vai para o log do servidor (só para teste).
SMTP_URL=""
EMAIL_REMETENTE="D'Cerutti <nao-responda@dcerutti.com.br>"

# Site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Senha dos usuários criados por `npm run db:seed` (somente desenvolvimento)
# O seed só roda com banco local e SEED_PERMITIDO=1. Nunca defina isso no servidor.
SEED_PERMITIDO="1"
SEED_SENHA=""
