# Banco (docker-compose expõe o MySQL na porta 3307)
DATABASE_URL="mysql://dcerutti:dcerutti@localhost:3307/dcerutti"

# Autenticação (Better Auth) — gere com: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Opcional: assina os links públicos de pedido (/p/PED-000123.…, D-20). Sem ele, usa o BETTER_AUTH_SECRET.
# Trocar invalida os links já enviados.
LINK_PEDIDO_SEGREDO=""

# Fotos enviadas ficam no servidor (D-13). Padrão: <projeto>/armazenamento
ARMAZENAMENTO_DIR=""

# E-mail (recuperação de senha). Sem SMTP_URL, o e-mail vai para o log do servidor (só para teste).
SMTP_URL=""
EMAIL_REMETENTE="D'Cerutti <nao-responda@dcerutti.com.br>"

# Site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Pagamento online com Mercado Pago (docs/27). Sem MP_ACCESS_TOKEN, nada é cobrado (o painel avisa).
# Access Token da aplicação (Suas integrações → Credenciais). Teste no ambiente de teste; produção só no .env da produção.
MP_ACCESS_TOKEN=""
# Chave secreta dos avisos (Suas integrações → Webhooks → Configurar notificações → evento "Order"). URL do aviso:
#   https://<domínio>/api/pagamentos/mercadopago
MP_WEBHOOK_SECRET=""
# Durante a troca da chave secreta no Mercado Pago, a chave antiga continua valendo até ser apagada daqui.
MP_WEBHOOK_SECRET_ANTERIOR=""
# Ambiente das credenciais: "producao" ou "teste". Aviso do outro ambiente (live_mode) é ignorado e o gestor é avisado.
MP_AMBIENTE=""
# Só para testes: PAGAMENTO_GATEWAY=falso usa um Mercado Pago simulado em memória. Nunca vale no banco de produção
# (nome terminando em _producao) nem com PAGAMENTO_PRODUCAO=1: lá o pagamento fica bloqueado e o painel avisa.
PAGAMENTO_GATEWAY=""

# Senha dos usuários criados por `npm run db:seed` (somente desenvolvimento)
# O seed só roda com banco local e SEED_PERMITIDO=1. Nunca defina isso no servidor.
SEED_PERMITIDO="1"
SEED_SENHA=""
